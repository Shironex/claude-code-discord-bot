{
  "name": "@claude-code/shared",
  "version": "0.0.0",
  "description": "Shared TypeScript types and interfaces for Claude Code Discord Bot and Image Service",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "winston": "^3.14.2",
    "nest-winston": "^1.10.0",
    "chalk": "^4.1.2 || ^5.0.0",
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "@nestjs/config": "^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "winston": {
      "optional": false
    },
    "nest-winston": {
      "optional": false
    },
    "chalk": {
      "optional": false
    },
    "@nestjs/common": {
      "optional": false
    },
    "@nestjs/config": {
      "optional": true
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.6.2",
    "tsup": "^8.5.0",
    "winston": "^3.17.0",
    "nest-winston": "^1.10.2",
    "chalk": "^5.6.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2"
  }
}