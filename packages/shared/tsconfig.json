{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "composite": false,
    "noEmitOnError": false,
    "types": ["node", "jest", "jest-extended"]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "jest.setup.ts",
    "jest.config.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "coverage"
  ],
}