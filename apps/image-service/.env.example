# ==============================================================================
# IMAGE SERVICE ENVIRONMENT CONFIGURATION
# ==============================================================================
# This file provides comprehensive configuration options for the image service.
# Copy this file to .env and configure the required values for your environment.
# 
# To generate new API keys and secrets, run: bash scripts/generate-keys.sh
# ==============================================================================

# ==============================================================================
# CORE APPLICATION CONFIGURATION (Required)
# ==============================================================================

# Application environment: development, production, or test
# Affects default logging levels, validation strictness, and security settings
NODE_ENV=development

# Server port number (1-65535)
# Default: 3001
PORT=3001

# Base URL for the image service - used for generating image URLs
# Must be a valid HTTP/HTTPS URL. Set to your production domain in production.
# Example: https://images.yourdomain.com
IMAGE_SERVICE_BASE_URL=http://localhost:3001

# ==============================================================================
# AUTHENTICATION CONFIGURATION (Production Required)
# ==============================================================================

# API key for Discord bot authentication (minimum 32 characters)
# This key should be configured in your Discord bot's environment file
# Generate with: bash scripts/generate-keys.sh
DISCORD_BOT_API_KEY=discord_AbCdEf1234567890_base64url_encoded_key_here

# API key for Claude Code authentication (minimum 32 characters)  
# This key should be added to GitHub workflow secrets
# See: discord bot templates/claude-workflow-self-hosted.yml
# Generate with: bash scripts/generate-keys.sh
CLAUDE_CODE_API_KEY=claude_XyZ9876543210_base64url_encoded_key_here

# HMAC secret for request signature validation (minimum 32 characters)
# Used for securing API requests with cryptographic signatures
# Generate with: bash scripts/generate-keys.sh
HMAC_SECRET=base64_encoded_hmac_secret_for_signature_validation

# Whether HMAC signature validation is required for all requests
# Recommended: true for production, false for development
REQUIRE_HMAC=false

# Whether to enable HMAC signature validation globally
# When enabled, all API requests must include valid HMAC signatures
ENABLE_HMAC_VALIDATION=false

# ==============================================================================
# REDIS CONFIGURATION (Required)
# ==============================================================================

# Redis server hostname or IP address
# Default: localhost
REDIS_HOST=localhost

# Redis server port (1-65535)
# Default: 6379
REDIS_PORT=6379

# Redis server username (optional)
# Leave empty if Redis doesn't require username authentication
REDIS_USERNAME=

# Redis server password (optional)
# Leave empty if Redis doesn't require authentication
REDIS_PASSWORD=

# Redis database number (0-15)
# Default: 0
REDIS_DB=0

# Maximum Redis connection retries (0-10)
# Default: 3
REDIS_MAX_RETRIES=3

# Redis retry delay in milliseconds (50-5000)
# Default: 100
REDIS_RETRY_DELAY=100

# ==============================================================================
# FILE UPLOAD CONFIGURATION (Optional)
# ==============================================================================

# Maximum file size in bytes (1KB - 100MB)
# Default: 10485760 (10MB)
MAX_FILE_SIZE=10485760

# Maximum number of files per upload request (1-50)
# Default: 10
MAX_FILES_PER_REQUEST=10

# Comma-separated list of allowed MIME types (must start with image/)
# Default: Uses predefined image types from IMAGE_CONSTANTS
# Example: image/jpeg,image/png,image/gif,image/webp
# ALLOWED_MIMETYPES=image/jpeg,image/png,image/gif,image/webp,image/bmp,image/tiff

# ==============================================================================
# TTL (TIME TO LIVE) CONFIGURATION (Optional)
# ==============================================================================

# Default TTL for uploaded images in seconds (5 minutes - 1 week)
# Default: 1800 (30 minutes)
DEFAULT_TTL_SECONDS=1800

# Minimum allowed TTL in seconds (1 minute - 1 hour)
# Default: 300 (5 minutes)
MIN_TTL_SECONDS=300

# Maximum allowed TTL in seconds (1 hour - 30 days)
# Default: 172800 (2 days)
MAX_TTL_SECONDS=172800

# ==============================================================================
# RATE LIMITING CONFIGURATION (Optional)
# ==============================================================================

# Maximum files per user per hour (1-1000)
# Default: 50
MAX_FILES_PER_HOUR=50

# Maximum total size per upload request in bytes (1KB - 500MB)
# Default: 52428800 (50MB)
MAX_TOTAL_SIZE_PER_REQUEST=52428800

# ==============================================================================
# CORS CONFIGURATION (Optional)
# ==============================================================================

# CORS allowed origins - single URL, comma-separated URLs, or * for all
# Examples:
#   Single origin: http://localhost:3000
#   Multiple origins: http://localhost:3000,https://yourdomain.com
#   All origins: *
# Default: http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Whether to allow credentials in CORS requests
# Default: false
CORS_CREDENTIALS=false

# ==============================================================================
# SECURITY CONFIGURATION (Optional)
# ==============================================================================

# Maximum allowed timestamp drift in seconds for HMAC validation (1 minute - 1 hour)
# Prevents replay attacks by rejecting requests with old timestamps
# Default: 300 (5 minutes)
MAX_TIMESTAMP_DRIFT=300

# ==============================================================================
# DOCUMENTATION CONFIGURATION (Optional)
# ==============================================================================

# Whether to enable Swagger/OpenAPI documentation
# Access at: /api-docs
# Default: true
ENABLE_SWAGGER=true

# Whether to enable Scalar API reference
# Access at: /reference
# Default: true
ENABLE_SCALAR=true

# ==============================================================================
# SECURITY HEADERS CONFIGURATION (Optional)
# ==============================================================================

# HTTP Strict Transport Security (HSTS) max age in seconds (0 - 2 years)
# Default: 31536000 (1 year)
HSTS_MAX_AGE=31536000

# Whether to include subdomains in HSTS policy
# Default: true
HSTS_INCLUDE_SUBDOMAINS=true

# Whether to enable HSTS preload (for inclusion in browser preload lists)
# Default: true
HSTS_PRELOAD=true

# Referrer policy setting - controls how much referrer information is sent
# Valid values: no-referrer, no-referrer-when-downgrade, origin, 
#               origin-when-cross-origin, same-origin, strict-origin,
#               strict-origin-when-cross-origin, unsafe-url
# Default: no-referrer
REFERRER_POLICY=no-referrer

# ==============================================================================
# FILE CLEANUP CONFIGURATION (Optional)
# ==============================================================================

# File cleanup check interval in seconds (1 minute - 1 hour)
# How often the system checks for expired files to delete
# Default: 300 (5 minutes)
CLEANUP_INTERVAL=300

# ==============================================================================
# VALIDATION NOTES
# ==============================================================================
# 
# The following validation rules are enforced:
# 
# 1. TTL Relationships: MIN_TTL_SECONDS ≤ DEFAULT_TTL_SECONDS ≤ MAX_TTL_SECONDS
# 2. Production Requirements:
#    - At least one API key (DISCORD_BOT_API_KEY or CLAUDE_CODE_API_KEY) must be provided
#    - If ENABLE_HMAC_VALIDATION is true, HMAC_SECRET must be at least 32 characters
# 3. File Size Limits: File sizes must be reasonable (1KB minimum, 100MB maximum)
# 4. Port Numbers: Must be valid port numbers (1-65535)
# 5. URLs: Must be valid HTTP/HTTPS URLs where applicable
# 
# The application will fail to start with clear error messages if validation fails.
# ==============================================================================