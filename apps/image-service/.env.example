# =================================
# Image Service Configuration
# =================================

# Server Configuration
PORT=3001
NODE_ENV=development

# Required API Security
IMAGE_SERVICE_API_KEY=your_super_secret_api_key_here
IMAGE_SERVICE_HMAC_SECRET=your_hmac_secret_for_request_validation

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=100
REDIS_KEY_PREFIX=img_service:
REDIS_CONNECTION_NAME=image-service
REDIS_LOADING_TIMEOUT=5000
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB in bytes
MAX_FILES_PER_REQUEST=10
MAX_TOTAL_SIZE_PER_REQUEST=52428800  # 50MB in bytes
ALLOWED_MIMETYPES=image/jpeg,image/jpg,image/png,image/gif,image/webp,image/bmp,image/tiff

# TTL Configuration (in seconds)
DEFAULT_TTL_SECONDS=1800  # 30 minutes
MAX_TTL_SECONDS=7200      # 2 hours
MIN_TTL_SECONDS=300       # 5 minutes

# Rate Limiting
MAX_FILES_PER_HOUR=50

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# Security Configuration
MAX_TIMESTAMP_DRIFT=300000  # 5 minutes in milliseconds
ENABLE_HMAC_VALIDATION=true

# Service Features
ENABLE_SWAGGER=true
ENABLE_SCHEDULER=true
ENABLE_METRICS=true
GRACEFUL_SHUTDOWN_TIMEOUT=10000

# API Paths
HEALTH_CHECK_PATH=/health
METRICS_PATH=/metrics
SWAGGER_PATH=/api
GLOBAL_PREFIX=

# Versioning
ENABLE_VERSIONING=false
DEFAULT_VERSION=1