# Server Configuration
PORT=3001
NODE_ENV=development
IMAGE_SERVICE_BASE_URL=http://localhost:3001  # Base URL for generating image URLs (set to your production domain)

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Authentication Keys (Generate these using the /api/v1/auth/setup endpoint)
# These are NOT your Discord bot token or Claude API keys - they are custom keys for this service
DISCORD_BOT_API_KEY=discord_AbCdEf1234567890_base64url_encoded_key_here
CLAUDE_CODE_API_KEY=claude_XyZ9876543210_base64url_encoded_key_here
HMAC_SECRET=base64_encoded_hmac_secret_for_signature_validation

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Optional: Image Service Configuration
IMAGE_SERVICE_UPLOAD_MAX_FILE_SIZE=10485760
IMAGE_SERVICE_UPLOAD_MAX_FILES=10
IMAGE_SERVICE_RATE_LIMIT_MAX_FILES_PER_HOUR=50