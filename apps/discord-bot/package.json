{
	"name": "@claude-code/discord-bot",
	"version": "1.1.0",
	"license": "MIT",
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "nest build -p tsconfig.build.json",
		"dev": "nest start --watch",
		"format": "prettier --write \"src/**/*.ts\"",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "eslint src/**/*.ts --fix",
		"typecheck": "tsc --noEmit",
		"typecheck:build": "tsc --noEmit -p tsconfig.build.json",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:unit": "jest --testPathPatterns=unit",
		"test:integration": "jest --testPathPatterns=integration",
		"test:e2e": "jest --testPathPatterns=e2e",
		"test:ci": "jest --coverage --ci --reporters=default --reporters=jest-junit"
	},
	"dependencies": {
		"@claude-code/shared": "workspace:*",
		"@nestjs/common": "^11.0.6",
		"@nestjs/config": "^4.0.2",
		"@nestjs/core": "^11.0.6",
		"@octokit/rest": "^22.0.0",
		"axios": "^1.13.5",
		"discord.js": "14.21.0",
		"necord": "6.9.1",
		"reflect-metadata": "0.2.2",
		"rimraf": "6.0.1",
		"rxjs": "7.8.2",
		"winston-daily-rotate-file": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.1.0",
		"@eslint/js": "^9.10.0",
		"@nestjs/cli": "^11.0.10",
		"@nestjs/testing": "^11.1.6",
		"@swc/jest": "^0.2.39",
		"@types/jest": "^30.0.0",
		"@types/node": "24.1.0",
		"@typescript-eslint/eslint-plugin": "8.38.0",
		"@typescript-eslint/parser": "8.38.0",
		"eslint": "9.32.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-prettier": "5.5.3",
		"globals": "^16.0.0",
		"jest": "^30.1.1",
		"jest-junit": "^16.0.0",
		"jest-mock-extended": "^4.0.0",
		"prettier": "3.6.2",
		"ts-jest": "^29.4.1",
		"tsconfig-paths": "^4.2.0",
		"typescript": "5.8.3"
	}
}