# Discord Configuration
DISCORD_TOKEN="your_discord_bot_token"
DEV_GUILD="your_development_guild_id"

# GitHub Integration
GITHUB_TOKEN="your_github_personal_access_token"

# Logging Configuration
LOG_LEVEL="info"                    # Minimum log level: error, warn, info, debug, verbose
ENABLE_FILE_LOGS="true"            # Enable file logging (true/false)
LOG_DIR="logs"                     # Directory for log files (relative to project root)
LOG_MAX_FILES="14d"                # Days to retain log files (e.g., "7d", "30d")