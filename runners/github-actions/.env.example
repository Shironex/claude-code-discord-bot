# GitHub Actions Self-Hosted Runner Environment Configuration
# Copy this file to .env and fill in your values

# Required: GitHub Personal Access Token
# Needs 'repo' and 'actions:write' scopes
# Get it from: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Required: GitHub Repository (format: owner/repo)
# Example: Shironex/claude-code-discord-bot
GITHUB_REPOSITORY=your_username/your_repository

# Optional: Custom runner name (defaults to claude-runner-<hostname>)
RUNNER_NAME=claude-runner-local

# Optional: Runner labels (comma-separated, no spaces)
# Default: self-hosted,claude-workflows
RUNNER_LABELS=self-hosted,claude-workflows,local-test

# Optional: Runner group (defaults to default)
RUNNER_GROUP=default